# ── LLM Provider ──────────────────────────────────────────────────────────────
# Options: ollama (local) | openai | anthropic
PROVIDER=ollama
OLLAMA_API_BASE=http://localhost:11434

# ── Model aliases (one env var per agent role) ────────────────────────────────
# Coder: frontend + backend agents (code generation)
CODER_MODEL=ollama/qwen2.5-coder:14b
# Reasoner: analyst + architect + pm agents (planning & reasoning)
REASONER_MODEL=ollama/qwen3:14b
# Fast: intake + classification (lightweight, high throughput)
FAST_MODEL=ollama/llama3.1:8b

# ── Persistence ───────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./planex.db

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# Set to DEBUG to see full LiteLLM request/response traces
LITELLM_LOG=ERROR
